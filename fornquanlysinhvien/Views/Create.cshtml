@model fornquanlysinhvien.Models.Student

@{
    ViewData["Title"] = "Thêm Sinh Viên";
}

<div class="container mt-4">
    <h2>Nhập Thông Tin Sinh Viên</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div class="form-group mb-3">
                    <label asp-for="Username" class="control-label fw-bold">Tên đăng nhập</label>
                    <input asp-for="Username" class="form-control" placeholder="Nhập username" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PasswordHash" class="control-label fw-bold">Mật khẩu</label>
                    <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="PasswordHash" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="LastName" class="control-label fw-bold">Họ</label>
                    <input asp-for="LastName" class="form-control" placeholder="Nhập họ" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="FirstName" class="control-label fw-bold">Tên</label>
                    <input asp-for="FirstName" class="form-control" placeholder="Nhập tên" />
                </div>

                <button type="submit" class="btn btn-primary">Lưu Sinh Viên</button>
                <a asp-action="Index" class="btn btn-secondary">Xem Danh Sách</a>
            </form>
        </div>
    </div>
</div>