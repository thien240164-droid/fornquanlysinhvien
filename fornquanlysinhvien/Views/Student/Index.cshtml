@model IEnumerable<fornquanlysinhvien.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Thêm sinh viên mới
            </a>
        </div>
    </div>

    @if (Model.Count() == 0)
    {
        <div class="alert alert-info" role="alert">
            <strong>Thông báo:</strong> Hiện không có sinh viên nào trong hệ thống.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Mã sinh viên</th>
                        <th>Tên người dùng</th>
                        <th>Tên</th>
                        <th>Email</th>
                        <th>Lớp</th>
                        <th>Ngành học</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.StudentId</td>
                            <td>@item.Username</td>
                            <td>@item.FirstName @item.LastName</td>
                            <td>@item.Email</td>
                            <td>@item.ClassName</td>
                            <td>@item.Major</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i> Xem
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Xóa">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Add confirmation dialog for delete action
        document.querySelectorAll('a[asp-action="Delete"]').forEach(link => {
            link.addEventListener('click', function(e) {
                if (!confirm('Bạn có chắc chắn muốn xóa sinh viên này?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
